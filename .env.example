# Klucz API modelu (np. Anthropic Claude)
ANTHROPIC_API_KEY=your_api_key_here

# Modele Anthropic per krok (opcjonalne - poniższe wartości to domyślne).
# Klasyfikacja to proste zadanie zamknięte -> tani model. Generowanie
# odpowiedzi -> droższy, lepszy jakościowo model.
# CLASSIFY_MODEL_NAME=claude-haiku-4-5
# GENERATE_MODEL_NAME=claude-sonnet-5

# Próg pewności klasyfikacji, poniżej którego zgłoszenie trafia do człowieka
CONFIDENCE_THRESHOLD=0.85

# Gmail API (gmail_app.py) - plik OAuth client ID z Google Cloud Console
# (typ "Desktop app"). Domyślnie "client_secret.json" w katalogu głównym.
# GMAIL_CREDENTIALS_PATH=client_secret.json
# GMAIL_TOKEN_PATH=gmail_token.json
# GMAIL_QUERY=is:unread in:inbox
# GMAIL_MAX_RESULTS=10

# LangSmith (opcjonalne, obserwowalność - trace każdego uruchomienia grafu
# w UI na smith.langchain.com). Bez klucza agent działa identycznie, po prostu
# bez trace'ów. Załóż darmowe konto na smith.langchain.com, żeby dostać klucz.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGSMITH_PROJECT=email-triage-agent
